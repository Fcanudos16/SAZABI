SAZABI_ENV=development
DATABASE_PATH=data/sazabi.db
CACHE_TTL_HOURS=24
LOG_LEVEL=INFO
LOG_FILE=logs/sazabi.log

# Região padrão usada quando o pedido não informa cidade (opcional)
DEFAULT_REGION=

# Telegram: somente conversas privadas de IDs autorizados
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

AI_PROVIDER=none
# Para habilitar /groq: AI_PROVIDER=groq; envia trechos de evidências ao Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Pesquisa real usa Tavily Search. Sem chave, somente memória local.
SEARCH_API_KEY=
SEARCH_LIMIT=5

# /ai: terminal nativo conectado à LAYLA Mark 5 local
LAYLA_URL=http://127.0.0.1:5000
# Opcional: sessão autorizada pela LAYLA; nunca compartilhe ou versione
LAYLA_SESSION_COOKIE=

# Perfil comercial local; caminho relativo à pasta deste .env ou absoluto.
COMMERCIAL_PROFILE_PATH=commercial_profile.json
# Agente pessoal: caminhos locais autorizados, separados por ponto e vírgula.
# Se omitido, somente a pasta do SAZABI. Nunca use a raiz inteira do disco.
# LOCAL_ROOTS=C:\Users\SeuUsuario\Documents\Projetos;C:\Users\SeuUsuario\Downloads\Organizar
# Rotinas opcionais: argv explícito (sem shell) e cwd dentro de LOCAL_ROOTS.
# Cada execução exige prévia e /confirm; não é sandbox de código.
LOCAL_ROUTINES_JSON={}

# Pesquisa pública somente sob comando explícito /research web ou url.
# Não usa Tavily/Groq nem envia arquivos locais. Use disabled para bloquear web.
KNOWLEDGE_WEB=wikimedia
KNOWLEDGE_LANGUAGE=pt

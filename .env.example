SAZABI_ENV=development
DATABASE_PATH=data/sazabi.db
CACHE_TTL_HOURS=24
LOG_LEVEL=INFO
LOG_FILE=logs/sazabi.log

# Região padrão usada quando o pedido não informa cidade (opcional)
DEFAULT_REGION=

# Telegram: somente conversas privadas de IDs autorizados
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

AI_PROVIDER=none
# Para habilitar /ai: AI_PROVIDER=ollama; endpoint fixo 127.0.0.1:11434
OLLAMA_MODEL=

# Pesquisa real usa Brave Search. Sem chave, somente memória local.
SEARCH_API_KEY=
SEARCH_LIMIT=5
